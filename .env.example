# JobPaper — environment
#
# v1 needs NO environment variables. The engine runs client-side, nothing is
# stored server-side, and there is no auth, no database and no API route.
# Copy this file to .env.local only when you start Phase 2.

# The canonical origin. Used by metadata, canonical tags, sitemap.xml and
# robots.txt. Set this per deployment — without it, canonicals and the
# sitemap emit localhost and Search Console will reject them.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Google Search Console DNS/HTML verification token (public by design).
# NEXT_PUBLIC_GSC_VERIFICATION=

# AdSense publisher id, e.g. pub-0000000000000000. Public by design.
# Only set this once the site is approved — the loader should not ship before.
# NEXT_PUBLIC_ADSENSE_CLIENT=

# ---------------------------------------------------------------------------
# Phase 2 — ALL server-side only. Never prefix a secret with NEXT_PUBLIC_:
# anything so prefixed is inlined into the client bundle and is public.
# ---------------------------------------------------------------------------
# Job description -> line items, and photo -> scope draft
# AI_SCOPE_MODEL=
# Licensed cost data feed that replaces the placeholder pricing
# COST_DATA_API_KEY=

# Rate limiting on every AI route (5 uploads/hr/IP, 20 explanations/hr/IP)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Hard monthly AI spend cap, in whole USD. On breach, degrade to manual entry.
# AI_MONTHLY_SPEND_CAP_USD=

# Premium PDF checkout
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
